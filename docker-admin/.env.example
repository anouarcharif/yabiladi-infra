# Modèle des variables lues par docker-admin/compose.yaml.
#
# À NE PAS COPIER EN « docker-admin/.env » : cette pile n'a pas son propre
# fichier d'environnement. Les trois scripts de scripts/ interpolent à partir du
# « .env » versionné de la racine (« docker compose --env-file ../../.env »),
# pour que le fuseau horaire et les versions d'images restent une seule vérité
# sur la machine, comme pour les trois autres projets du dépôt. Ce gabarit rend
# donc les lignes à reporter dans ../../.env — et rien d'autre.
#
# Le réglage par machine (réserves CPU/RAM, certificat auto-signé d'un poste qui
# ne peut pas prouver un nom public) ne se pose pas ici non plus : il va dans
# docker-admin/compose.override.yaml, modèle en compose.override.yaml.example.

###> console d'administration Docker (Portainer + Dozzle) ###

# Fuseau horaire des horodatages affichés par Dozzle. Le même que DBACKUP_TZ et
# que celui de Dagu : une ligne de journal et une planification de sauvegarde
# lues à la même heure doivent désigner la même minute. Les images sont en UTC
# sans cette variable.
ADMIN_TZ=Europe/Paris

# Versions d'images, avec leur défaut écrit dans compose.yaml. Ces deux lignes
# ne servent qu'à figer une version — après un rollback, ou pour attendre la
# prochaine mouture avant de la monter sur le serveur. Les laisser absentes
# garde le défaut du fichier versionné.
# ADMIN_PORTAINER_IMAGE=portainer/portainer-ce:2.45.3-alpine
# ADMIN_DOZZLE_IMAGE=amir20/dozzle:v11.4.2-alpine

###< console d'administration Docker ###
