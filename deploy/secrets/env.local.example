# Gabarit de .env.local — les NOMS seulement, jamais une valeur.
#
# Le coffre (.env.local.sops.bin) est chiffré en mode binaire, donc fidèle octet
# pour octet, mais illisible dans un git diff. Ce fichier est la contrepartie :
# c'est ici qu'on lit ce que contient le coffre, et ce qu'il faut fournir quand on
# monte une nouvelle machine.
#
# Sur le serveur, ce fichier n'a rien à faire : « ./deploy.sh » materialise
# .env.local depuis le coffre. Sur un poste de dev, copier ce gabarit en .env.local
# et le remplir à la main, ou le materialiser depuis le coffre avec la clé age.
#
# APP_SECRET figure ici volontairement : la valeur déployée doit ECRASER celle du
# .env versionné, qui est publique (le dépôt est sur GitHub).

# --- Base de données (Doctrine + scripts legacy) -------------------------------
# URL complètes « mysql://utilisateur:motdepasse@hote:port/nom?serverVersion=… »,
# une par schéma lu par l'application.
#
# DATABASE_URL est la connexion par défaut de la V2 (celle que Doctrine prend quand
# rien d'autre n'est demandé). Sans elle ici, le serveur hérite de l'hôte
# « database » du .env versionné — le nom du service Docker du poste de dev — et
# tout ce qui passe par la connexion par défaut échoue.
#
# Schémas attendus, repris de app/Config/database.php du CakePHP (V1) :
#   DATABASE_URL / LEGACY_DATABASE_URL -> « site »      (site_users, comptes membres)
#   LEGACY_SITE_DATABASE_URL           -> « site »      (news_*, phorum_users, annuaire)
#   LEGACY_ADMIN_DATABASE_URL          -> « site »      (back-office)
#   LEGACY_FORUM_DATABASE_URL          -> « new_forum » (phorum_*)
#   LEGACY_RENCONTRE_DATABASE_URL      -> « rencontres » (vld_pictures, pays)
#   LEGACY_YABILADIES_DATABASE_URL     -> « yabiladies » (users_imcs, ovulations)
# « yabiladies » est une base DISTINCTE : la pointer sur « site » ne provoque
# aucune erreur de connexion, elle vide silencieusement l'historique IMC et
# l'ovulation (tables absentes du schéma). La V1 la déclarait à part ; le schéma
# contient aussi une copie ancienne de news_articles, ne pas s'y fier.
DATABASE_URL=
LEGACY_DATABASE_URL=
LEGACY_SITE_DATABASE_URL=
LEGACY_ADMIN_DATABASE_URL=
LEGACY_FORUM_DATABASE_URL=
LEGACY_RENCONTRE_DATABASE_URL=
LEGACY_YABILADIES_DATABASE_URL=

# Sel de hachage repris du CakePHP (Configure::write('security.salt')). Change
# l'interprétation de tout mot de passe déjà stocké : ne jamais le « régénérer ».
LEGACY_SECURITY_SALT=

# --- Secrets applicatifs -------------------------------------------------------
# Clé de signature/chiffrement Symfony ; doit différer de la valeur du .env public.
APP_SECRET=

# OAuth Google et API OpenAI du bot de veille.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OPENAI_API_KEY=

# Firebase (notifications push) et APNS (certificat iOS).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
LEGACY_FCM_API_KEY=
LEGACY_FCM_CONNECT_API_KEY=
LEGACY_FCM_NEWS_API_KEY=
LEGACY_APNS_CERT_PATH=
LEGACY_APNS_CERT_PASSPHRASE=

# --- Réglages qui ne sont pas des secrets --------------------------------------
# Environnement résolu par l'application. Le .env versionné porte « dev » et
# « debug=1 » parce qu'il décrit un poste de travail ; un serveur qui se
# retrouverait avec ces valeurs publierait des pages d'erreur détaillées et
# n'aurait pas de cache compilé (vérifié par « ./deploy.sh », qui affiche
# l'environnement résolu avant de conclure). À poser ici plutôt que dans
# compose.override.yaml : .env.local est déjà le fichier propre à la machine, et
# une variable d'environnement du conteneur ecrase .env comme lui.
APP_ENV=
APP_DEBUG=
# Chemin d'hôte où sont écrits les carrousels radio mis en cache.
LEGACY_RADIO_CACHE_DIR=
# Collecte des profils Xdebug/Blackfire (à laisser hors production).
YB_PROFILER_COLLECT=

# --- Emplacements propres à la machine ----------------------------------------
# Chemins vus de l'hôte, interpolés par Compose. « deploy.sh » publie .env.local au
# shell avant d'appeler Compose : sans une ligne ici, la clé retombe sur son défaut
# du .env versionné — un chemin de poste de travail, donc relatif au dépôt. Les
# archives partiraient alors dans le dépôt et « ./deploy.sh » s'en apercevrait
# (« prepare_backups » refuse cette destination sur une machine), mais le dépôt
# serait le mauvais disque.
#
# Les dépôts visés par la machine cible : /var/yabiladi (la pile), /var/mediakit,
# /var/facturation. Les deux derniers ne sont pas frères de la pile, d'où les
# valeurs absolues ci-dessous — le défaut du .env versionné, « ../Yabiladi-*-V2 »,
# ne désigne rien sur cette machine.
MEDIAKIT_HOST_DIR=
FACTURATION_HOST_DIR=
# Destination des archives DBackup : un répertoire du NFS de sauvegarde, monté en
# écriture sous /backups et préparé en 1001:33 par deploy.sh. Un job y écrit un
# sous-dossier portant son nom.
DBACKUP_DEST_HOST_PATH=
# Atelier de restauration : le disque qui a la place (restaurer « media » ou
# « radio-content » fait la taille du dossier).
DBACKUP_RESTORE_HOST_PATH=
# Atterrissage des archives mariabackup ramenées en SSH du serveur MariaDB par le
# DAG « mariadb_fetch » ; relu le soir par le job « Fichiers - mariadb-physical ».
# Hors de la destination des archives : la console monterait deux fois le même
# dossier, une fois en écriture et une fois comme source.
MARIADB_BACKUP_HOST_PATH=
# Discothèque des quatre antennes (les MP3 que lisent sc_trans). Défaut
# « ./data/radio_content », sous le dépôt. Le job de sauvegarde suit cette même
# variable : ce que jouent les antennes est exactement ce qui est archivé.
RADIO_CONTENT_HOST_PATH=
