      "type": "stat",
      "title": "Total 5xx",
      "description": "Nombre total d'erreurs serveur (500, 502, 503, 504) sur la période",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"nginx\", container=~\"$container\"} | regexp `\" (?P<code>5[0-9]{2}) ` [$__range]))",
          "refId": "A",
          "instant": true
