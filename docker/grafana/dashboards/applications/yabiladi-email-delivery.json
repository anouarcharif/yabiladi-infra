    {
      "type": "timeseries",
      "title": "Tentatives de remise par statut",
      "description": "Chaque tentative de remise, répartie sur le statut SMTP écrit par postfix/smtp. Empilé : le vert est ce qui passe, l’orange ce qui sera réessayé, le rouge ce qui est perdu. Un différé qui ne se convertit jamais en sent finit par devenir bounced.",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "interval": "5m",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "yabiladi-loki"
          },
          "editorMode": "code",
          "expr": "sum by (status) (count_over_time({service=\"postfix\"} | regexp \"status=(?P<status>sent|deferred|bounced)\" [$__auto]))",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{status}}",
          "hide": false
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max",
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": true,
          "maxHeight": 600,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
