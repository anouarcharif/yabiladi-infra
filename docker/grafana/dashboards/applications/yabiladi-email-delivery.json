    {
      "type": "stat",
      "title": "Messages déposés",
      "description": "Une ligne par message accepté par Postfix (postfix/cleanup … message-id=…). Les rebonds générés par le relais lui-même comptent aussi : ce sont des messages, pas des envois applicatifs.",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "yabiladi-loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=\"postfix\"} |= \"message-id=\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "refId": "A",
          "legendFormat": "",
          "hide": false
