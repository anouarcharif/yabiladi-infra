            "uid": "yabiladi-loki"
          },
          "editorMode": "code",
          "expr": "sum by (relay) (count_over_time({service=\"postfix\"} |= \"relay=\" | regexp \"relay=(?P<relay>[A-Za-z0-9.-]+)\" [$__range]))",
          "queryType": "instant",
          "instant": true,
          "refId": "A",
          "legendFormat": "{{relay}}",
          "hide": false
