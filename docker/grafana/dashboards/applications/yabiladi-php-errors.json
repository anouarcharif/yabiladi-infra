      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "yabiladi-loki"
          },
          "editorMode": "code",
          "expr": "sum by (kind) (count_over_time({service=\"php\", container=~\"$container\"} | regexp \"(?P<kind>PHP (?:Fatal error|Warning|Notice|Parse error))\" [$__auto]))",
