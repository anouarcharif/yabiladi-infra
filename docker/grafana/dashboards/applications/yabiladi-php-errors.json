    {
      "type": "timeseries",
      "title": "Volume d’erreurs PHP par type",
      "description": "Type extrait du texte de la ligne (PHP Fatal error / Warning / Notice / Parse error). Le libellé exact vient du journal : rien n’est déduit.",
