    {
      "type": "timeseries",
      "title": "Latence — temps total (rt) et temps amont (urt)",
      "description": "rt=$request_time et urt=$upstream_response_time sont bien présents dans le format « main » versionné de docker/nginx/nginx.conf. urt ne prend que le PREMIER nombre de la ligne : quand nginx a réessayé l’amont, la variable contient « 0.010, 0.020 » et le panneau n’affiche que le premier appel. La latence réseau (rt - urt) n’est pas calculée ici, elle se déduit des deux courbes.",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "interval": "5m",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "yabiladi-loki"
          },
          "editorMode": "code",
          "expr": "avg_over_time({service=\"nginx\", container=~\"$container\"} | regexp \"rt=(?P<rt>[0-9.]+)\" | unwrap rt [$__interval])",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "rt moyenne",
          "hide": false
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "yabiladi-loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {service=\"nginx\", container=~\"$container\"} | regexp \"rt=(?P<rt>[0-9.]+)\" | unwrap rt [$__interval])",
          "queryType": "range",
          "refId": "B",
          "legendFormat": "rt 95e percentile",
          "hide": false
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "yabiladi-loki"
          },
          "editorMode": "code",
