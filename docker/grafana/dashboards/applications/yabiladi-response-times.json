{
  "uid": "yabiladi-response-times",
  "title": "Temps de réponse par page",
  "description": "Analyse des temps de réponse nginx (request_time, upstream_response_time) et ratios de cache, par page et par statut.",
  "tags": [
    "yabiladi",
    "loki",
    "nginx",
    "performance"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 42,
  "version": 0,
  "id": null,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "time_options": [
      "5m",
      "15m",
      "30m",
      "1h",
      "3h",
      "6h",
      "12h",
      "1d",
      "7d",
      "30d"
    ]
  },
  "links": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Conteneur",
        "type": "query",
        "hide": 0,
        "skipUrlSync": false,
        "datasource": {
          "type": "loki",
          "uid": "yabiladi-loki"
        },
        "query": "label_values({service=\"nginx\"}, container)",
        "definition": "label_values({service=\"nginx\"}, container)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": false,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "allowCustomValue": true
      },
      {
        "name": "path_filter",
        "label": "Filtre chemin",
        "type": "custom",
        "hide": 0,
        "skipUrlSync": false,
        "query": ".*",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "/articles/details/.*",
            "value": "/articles/details/.*"
          },
          {
            "selected": false,
            "text": "/prieres/.*",
            "value": "/prieres/.*"
          },
          {
            "selected": false,
            "text": "/forum/.*",
            "value": "/forum/.*"
          }
        ],
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "allowCustomValue": true
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Requêtes totales",
      "description": "Nombre total de requêtes sur la période",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"nginx\", container=~\"$container\"} |= `rt=` [$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Temps de réponse moyen",
      "description": "Moyenne des request_time (secondes)",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "avg(avg_over_time({service=\"nginx\", container=~\"$container\"} | regexp `rt=(?P<rt>[0-9.]+)` | unwrap rt [$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Cache HIT ratio",
      "description": "Pourcentage de requêtes servies depuis le cache nginx",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"nginx\", container=~\"$container\"} |= `cache=HIT` [$__range])) / sum(count_over_time({service=\"nginx\", container=~\"$container\"} | regexp `cache=(?P<cache>[A-Z]+)` [$__range])) * 100",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "P95 request_time",
      "description": "95ème percentile des temps de réponse (secondes)",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.95, {service=\"nginx\", container=~\"$container\"} | regexp `rt=(?P<rt>[0-9.]+)` | unwrap rt [$__range]) by ()",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Temps de réponse moyen par minute",
      "description": "Évolution du request_time moyen et du upstream_response_time moyen",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "avg(avg_over_time({service=\"nginx\", container=~\"$container\"} | regexp `rt=(?P<rt>[0-9.]+)` | unwrap rt [1m]))",
          "legendFormat": "request_time",
          "refId": "A"
        },
        {
          "expr": "avg(avg_over_time({service=\"nginx\", container=~\"$container\"} | regexp `urt=(?P<urt>[0-9.]+)` | unwrap urt [1m]))",
          "legendFormat": "upstream_response_time",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
