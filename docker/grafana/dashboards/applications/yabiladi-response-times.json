        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "table",
      "title": "Pages les plus lentes (P95)",
      "description": "Top 10 des chemins avec le P95 request_time le plus élevé",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "topk(10, quantile_over_time(0.95, {service=\"nginx\", container=~\"$container\"} | regexp `\"GET (?P<path>[^ ]+) [^\"]+\".*rt=(?P<rt>[0-9.]+)` | unwrap rt [$__range]) by (path))",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
