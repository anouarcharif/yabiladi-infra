      "targets": [
        {
          "expr": "sum by (cache) (count_over_time({service=\"nginx\", container=~\"$container\"} | regexp `cache=(?P<cache>[A-Z]+)` [1m]))",
          "legendFormat": "{{cache}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "",
