          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Chemin"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 600
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      }
    },
