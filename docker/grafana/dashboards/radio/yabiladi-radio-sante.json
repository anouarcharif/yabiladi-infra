  "panels": [
    {
      "type": "stat",
      "title": "Antennes vivantes (15 min)",
      "description": "Toujours sur les quatre antennes, quelle que soit la sélection : ce nombre est le contrôle de présence, pas une vue filtrée. Il compte les services qui ont écrit au moins une ligne « [DECODE] Opened » dans les quinze dernières minutes. Rouge à 3, une antenne ne programme plus rien — mais Azawan et Nayda peuvent être légitimement arrêtées par la grille : vérifier la case du jour dans docker/radio/grid.yaml avant de courir.",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "yabiladi-loki"
          },
          "editorMode": "code",
          "expr": "count(count by (service) (count_over_time({service=~\"radio-.+\"} |~ \"\\\\[DECODE\\\\] Opened\" [15m])))",
          "queryType": "instant",
          "instant": true,
          "refId": "A",
          "legendFormat": "",
          "hide": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
