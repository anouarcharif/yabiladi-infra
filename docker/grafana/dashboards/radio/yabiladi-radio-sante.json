    {
      "type": "stat",
      "title": "Incidents visibles (15 min)",
      "description": "Comptage agrégé des six signes de panne : source coupée ou refusée, playlist à sec, fichier indécodable, processus mort ou abandonné par supervisord, auditeurs refusés. Zéro veut dire « rien dans les logs », pas « rien cassé » : le port qui répond reste le HEALTHCHECK du conteneur.",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "yabiladi-loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service=~\"$station\"} |~ \"source disconnected|source rejected|Stream In Use|Ran out of songs|No entries found in playlist|Error opening decoder|nitializing encoder|Error in block selecting|exited: .*not expected|entered FATAL state|HTTP client connection rejected|Max users reached\" [15m]))",
          "queryType": "instant",
          "instant": true,
          "refId": "A",
          "legendFormat": "",
          "hide": false
        }
      ],
