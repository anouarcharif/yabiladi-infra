  "panels": [
    {
      "type": "stat",
      "title": "Antennes qui diffusent",
      "description": "Combien des quatre services radio ont écrit au moins une ligne sur la période. Une antenne absente d'ici n'est pas muette pour autant : c'est qu'aucun événement ne s'est produit (ou qu'elle est arrêtée). Le journal du DNAS ne produit rien entre deux connexions d'auditeur.",
      "datasource": {
        "type": "loki",
        "uid": "yabiladi-loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "yabiladi-loki"
          },
          "editorMode": "code",
          "expr": "count(count by (service) (count_over_time({service=~\"$station\"} [$__range])))",
