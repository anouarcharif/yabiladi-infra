    {
      "type": "timeseries",
      "title": "CPU des conteneurs",
      "description": "Fraction d'un cœur consommée par les trois conteneurs de la pile de journalisation (cAdvisor, regroupée par « service » — l'étiquette Docker « com.docker.compose.service » n'est pas exportée, voir §8.1). Le graphe ne voit que ce que Prometheus récolte : ni Loki ni Alloy ne sont scrapés, ce panneau reste donc muet sur un processus vivant mais bloqué.",
      "datasource": {
        "type": "prometheus",
        "uid": "yabiladi-prometheus"
      },
      "interval": "30s",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "yabiladi-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (service) (rate(container_cpu_usage_seconds_total{name=~\".+\",service=~\"loki|alloy|grafana\"}[$__rate_interval]))",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{service}}",
          "hide": false
        }
      ],
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max",
