# Variables Komodo provisionnées depuis le coffre Infra.
# Ne jamais mettre ces valeurs dans .env ou compose.yaml.

###> Core ###
KOMODO_HOST=https://komodo-imouzzer.yabiladi.com
KOMODO_TITLE=Yabiladi Komodo
KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=
KOMODO_INIT_ADMIN_PASSWORD=
KOMODO_JWT_SECRET=
KOMODO_WEBHOOK_SECRET=
KOMODO_DATABASE_USERNAME=
KOMODO_DATABASE_PASSWORD=
KOMODO_FIRST_SERVER_NAME=Imouzzer
# Legacy variables retained in the encrypted file for compatibility.
# docker-admin generates and stores each node's onboarding key automatically.
PERIPHERY_ONBOARDING_KEY=
KOMODO_TAROURT_ONBOARDING_KEY=
###< Core ###
