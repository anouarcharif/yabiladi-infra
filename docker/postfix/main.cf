# Gabarit rendu au démarrage (entrypoint.sh) : seule ${POSTFIX_MYHOSTNAME} est
# substituée. Les $variables restantes sont celles de Postfix.
#
# Ce fichier EST la configuration du conteneur à chaque démarrage : une valeur
# posée à la main par « postconf -e » pendant un debug (relayhost, un seuil) est
# effacée par le prochain « docker compose up -d » ou un restart. Mesuré le
# 2026-11-17. Ce qui doit durer se déclare ici (et se commit) ou passe par une
# variable d'environnement, jamais par « postconf -e » en running.
#
# Rôle : relais SMTP sortant pour php, dagu, grafana, facturation, mediakit et
# pour les machines déclarées dans POSTFIX_RELAY_NETWORKS. Aucune boîte locale
# n'existe (mydestination vide), aucune authentification n'existe : le
# conteneur ne fait que remettre les messages aux MX destinataires.
compatibility_level = 3.6
myhostname = ${POSTFIX_MYHOSTNAME}
mydomain = yabiladi.com
myorigin = $mydomain
mydestination =
local_recipient_maps =

inet_interfaces = all
# Le SPF ne publie que des ip4 : sortir en IPv6 ferait échouer SPF sur les
# serveurs qui n'ont pas de PTR v6.
inet_protocols = ipv4

# Pas de smtp_bind_address : le conteneur est sur le réseau bridge de Docker et
# ne possède aucune IP publique dans sa namespace — lier 57.128.22.216 ferait
# échouer chaque remise (« cannot assign requested address »). L'adresse source
# est donc choisie par la machine hôte, ce qui est précisément le but de poser
# ce relais sur imouzzer : l'IP primaire de cette machine est 57.128.22.216,
# son PTR est imouzzer.yabiladi.com, et le HELO ci-dessus est ce même nom.
# Le contrôle se joue à la première remise réelle : la ligne de refus d'un
# destinataire cite l'IP qu'il a vue, elle doit être .216.

# Les clients autorisés sont calculés au démarrage : les sous-réseaux des
# interfaces du conteneur (127.0.0.0/8 et le réseau « app », donc php, dagu,
# grafana, facturation, mediakit) plus POSTFIX_RELAY_NETWORKS — les machines
# d'où le courrier legacy est soumis depuis que leur propre Postfix est retiré.
# « subnet » reste la source de la première partie ; mynetworks est posé par
# l'entrypoint, qui ne peut pas deviner le CIDR de la machine.
mynetworks_style = subnet

smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_tls_security_level = none

# Sortie : STARTTLS opportuniste, vérification des certificats par la trousse
# CA de Debian.
smtp_tls_security_level = may
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1

# Rien n'est livré en local : les notifications « resource » et « software »
# du démon seraient acceptées faute de boîte, puis rebondies. Les journaux du
# conteneur et les alertes Grafana les remplacent.
notify_classes =

# smtpd_milters et non_smtpd_milters ne sont posés par entrypoint.sh que quand
# la clé DKIM est présente (voir opendkim.conf) : sans eux, le courrier soumis
# par un tiers (le V1, les shells de l'hôte) partirait non signé.
#
# « milter_default_action » : sa valeur par défaut passe de « tempfail » à
# « shutdown » entre Postfix 3.7 (base bookworm) et 3.10 (base trixie), et
# « compatibility_level = 3.6 » ne la garde pas — les deux valeurs ont été lues
# au « postconf » de chaque image, ce gabarit rendu dessus. Épinglée ici, la
# règle reste celle subie depuis le premier jour : un milter qui meurt en pleine
# session produit un échec temporaire (le message reste en file et repartira),
# et non une coupure de connexion. Ce n'est pas une préférence de style : la mort
# d'OpenDKIM est un état prévu par l'entrypoint (« broken ») et par
# healthcheck.sh, et le relais continue alors de remettre — avec cette ligne, il
# continue de remettre en attendant l'alerte ; sans elle, il fermerait les
# sessions SMTP de php, dagu et des shells au moment même où quelque chose tombe.
milter_default_action = tempfail
#
# Deux autres défauts bougent entre 3.7 et 3.10 et ne sont volontairement PAS
# épinglés, parce que la répétition a rendu exactement le même transcript des
# deux côtés :
#   - « smtpd_forbid_unauth_pipelining » (no → yes) ne regarde que les clients
#     qui n'ont pas le droit de relayer, et ceux-là reçoivent déjà un 554 après
#     RCPT (mesuré, image par image). La rafale « MAIL FROM + RCPT TO + DATA
#     d'une seule écriture », elle, rend « 250 250 354 » sur les deux versions :
#     nos clients sont tous dans mynetworks.
#   - « smtpd_forbid_bare_newline » (no → normalize) : un corps en LF seuls — ce
#     que produit un heredoc de shell — est accepté, remis et sa signature DKIM
#     vérifiée valide sur les deux versions.
maillog_file = /dev/stdout
message_size_limit = 26214400
biff = no
append_dot_mydomain = no
readme_directory = no
